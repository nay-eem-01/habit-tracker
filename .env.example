# Copy to .env (git-ignored) for local runs; set the same names as environment variables on a host.

# Database
DB_URL=jdbc:postgresql://localhost:5432/habit-tracker
DB_USERNAME=
DB_PASSWORD=

# At least 32 bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=

# Web app address (links in emails) and allowed CORS origins (comma-separated, no *)
APP_FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_DISPLAY_NAME=DevHabit

# Email (account mail only). Brevo free: smtp-relay.brevo.com:587, see docs/DEV_LOG.md
APP_NOTIFICATIONS_EMAIL_ENABLED=false
APP_NOTIFICATIONS_EMAIL_FROM=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# false only for a local catcher like Mailpit
MAIL_SMTP_AUTH=true

# File uploads stay off until storage survives redeploys
APP_FILES_ENABLED=false
APP_FILES_DIR=

# Production: SPRING_PROFILES_ACTIVE=prod (the Docker image sets it)
